function S(tag,attrs,parent){const e=document.createElementNS(NS,tag);for(const [k,v]of Object.entries(attrs||{}))e.setAttribute(k,v);if(parent)parent.appendChild(e);return e;}
function label(svg,x,y,t,size=15,fill='#9eb3d7'){const el=S('text',{x,y,fill,'text-anchor':'middle','font-family':'Segoe UI, system-ui, sans-serif','font-size':size,'font-weight':700},svg);el.textContent=t;return el;}
function btn(text,cls,fn){const b=document.createElement('button');b.type='button';b.className=cls;b.textContent=text;b.onclick=fn;return b;}
function tint(hex,f){return '#'+hex.slice(1).match(/../g).map(x=>{const c=parseInt(x,16);return Math.round(f>1?c+(255-c)*(f-1):c*f).toString(16).padStart(2,'0');}).join('');}
function points(k,n){const a=[],push=(x,y,old,row=0)=>a.push({x,y,old,row,id:a.length});
 if(k==='ones')push(0,0,true);
 if(k==='count')for(let j=0;j<n;j++)push(j,0,j<n-1);
 if(k==='odd'){for(let j=0;j<n-1;j++)push(j+.5,0,j<n-2);for(let j=0;j<n;j++)push(j,1,j<n-1);}
 if(k==='even')for(let r=0;r<2;r++)for(let j=0;j<n;j++)push(j,r,j<n-1);
 if(k==='tri')for(let r=1;r<=n;r++)for(let j=0;j<r;j++)push(j-(r-1)/2,(r-1)*.87,r<n,r-1);
 if(k==='sq')for(let r=0;r<n;r++)for(let j=0;j<n;j++)push(j,r,r<n-1&&j<n-1,r);
 if(k==='hex'){push(0,0,true);for(let ring=1;ring<n;ring++)gHexRing(ring,1).forEach(p=>push(p[0],p[1],ring<n-1,ring));}
 if(k==='p2'||k==='p3'){const base=k==='p2'?2:3;if(n===1)push(0,0,true);else{const prev=base**(n-2),cols=Math.ceil(Math.sqrt(prev));for(let g=0;g<base;g++)for(let j=0;j<prev;j++)push(g*(cols+1.35)+j%cols,Math.floor(j/cols),g===0,g);}}
 const xs=a.map(p=>p.x),ys=a.map(p=>p.y),x0=Math.min(...xs),x1=Math.max(...xs),y0=Math.min(...ys),y1=Math.max(...ys);const scale=Math.min(26,151/Math.max(1,x1-x0),114/Math.max(1,y1-y0));return a.map(p=>({...p,x:100+(p.x-(x0+x1)/2)*scale,y:80+(p.y-(y0+y1)/2)*scale,r:Math.min(9,scale*.31)}));
}
function cube(svg,n,animate){const u=Math.min(30,136/(2*n+(exploded?(n-1)*.9:0))),gap=exploded?u*.9:0,cy=80+n*u*.5+(n-1)*gap*.5;const project=(x,y,z,layer)=>[100+(x-y)*u*.866,cy+(x+y-n)*u*.5-z*u-layer*gap]